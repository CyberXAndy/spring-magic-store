{
  "resources": {
    "includes": [
      {
        "pattern": "\\Qapplication.properties\\E"
      },
      {
        "pattern": "\\Qapplication.yml\\E"
      },
      {
        "pattern": "\\Qapplication.yaml\\E"
      },
      {
        "pattern": "\\Qdata.sql\\E"
      },
      {
        "pattern": "\\Qschema.sql\\E"
      },
      {
        "pattern": "\\Qtemplates/.*\\.html\\E"
      },
      {
        "pattern": "\\Qstatic/.*\\E"
